{
  "name": "ghostly-store",
  "private": true,
  "type": "module",
  "description": "The official Ghostly store: its check and its index builder",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build-index": "tsx scripts/build-index.ts",
    "check": "scripts/check.sh",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
